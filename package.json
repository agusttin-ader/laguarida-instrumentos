{
  "name": "laguarida-guitarshop-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "verify": "npm run lint:strict && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "cleanup:supabase": "node scripts/cleanup-supabase-from-site.mjs",
    "sync:catalog": "node scripts/sync-catalog-backup.mjs",
    "sync": "npm run sync:catalog",
    "init:product-images": "node scripts/sync-catalog-backup.mjs --skip-download",
    "images:variants": "node scripts/generate-image-variants.mjs",
    "images:hero": "node scripts/generate-home-hero-variants.mjs",
    "images:all": "npm run images:variants && npm run images:hero",
    "images:audit": "node scripts/audit-image-variants.mjs",
    "perf:lighthouse": "node scripts/lighthouse-snapshot.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "geist": "^1.9.2",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "phosphor-react": "^1.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.28",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  }
}
