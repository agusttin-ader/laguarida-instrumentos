# Copiar este archivo a .env.local en la raíz del proyecto (no commitear .env.local)
# Dashboard Supabase → Project Settings → API

# Público (login admin en el navegador + API auth)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Servidor (opcional si ya usás las NEXT_PUBLIC_*; algunas rutas leen estas)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo server: CRUD de productos / storage admin (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Producción (www): dominio de cookie compartido entre subdominios. En localhost se ignora solo.
# SITE_COOKIE_DOMAIN=.laguaridainstrumentos.com

# Contingencia: catálogo público sin Supabase (solo backup local)
# SUPABASE_FULLY_BLOCKED=true